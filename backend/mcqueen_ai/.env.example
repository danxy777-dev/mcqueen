# Ambiente: development | production (no Render defina ENVIRONMENT=production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Provedor LLM (nunca envie chaves reais para o GitHub nem para o app Flutter)
# Padrão econômico OpenAI:
OPENAI_API_KEY=coloque-sua-chave-aqui
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=18

# Alternativa econômica Google Gemini (API OpenAI-compatível):
# LLM_API_KEY=sua-chave-ai-studio
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# Alternativa Groq:
# LLM_API_KEY=sua-chave-groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Somente para testes locais (ignorado automaticamente em ENVIRONMENT=production):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_ALLOW_EMPTY_KEY=true

# Segurança e proteção contra abuso
# Origens Web permitidas no CORS (em produção, nunca use '*'; apps Android nativos não precisam de CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
# Token opcional exigido no header X-Client-Token para /chat, /chat/stream e /status:
# MCQUEEN_CLIENT_TOKEN=

# Sessão e Rate Limit
MCQUEEN_SESSION_MAX_TURNS=10
MCQUEEN_SESSION_TTL_SECONDS=3600
MCQUEEN_MAX_SESSIONS=1000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Rede local (em nuvem como o Render o PORT é injetado automaticamente)
MCQUEEN_AI_HOST=0.0.0.0
MCQUEEN_AI_PORT=8000
